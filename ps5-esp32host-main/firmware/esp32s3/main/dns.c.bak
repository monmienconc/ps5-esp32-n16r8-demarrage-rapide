#include "dns.h"
#include <stdbool.h>
#include <string.h>

static uint16_t read16(const uint8_t *p) { return ((uint16_t)p[0] << 8) | p[1]; }

size_t ps5_dns_reply(const uint8_t *q, size_t size, uint8_t *out,
                     size_t capacity, const uint8_t ip[4])
{
    if (size < 17 || read16(q + 4) != 1 || (q[2] & 0xf8) != 0) return 0;
    char name[254];
    size_t pos = 12, used = 0;
    while (pos < size && q[pos]) {
        unsigned label = q[pos++];
        // Reject compression in questions instead of following untrusted pointers.
        if (label > 63 || pos + label >= size || used + label + 1 >= sizeof(name)) return 0;
        if (used) name[used++] = '.';
        for (unsigned i = 0; i < label; i++) {
            uint8_t c = q[pos++];
            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
                  (c >= '0' && c <= '9') || c == '-' || c == '_')) return 0;
            name[used++] = (c >= 'A' && c <= 'Z') ? c + ('a' - 'A') : c;
        }
    }
    if (pos >= size || pos + 5 > size) return 0;
    name[used] = 0;
    pos++;
    uint16_t type = read16(q + pos), klass = read16(q + pos + 2);
    pos += 4;
    if (klass != 1 || capacity < pos + 16) return 0;
    bool known = !strcmp(name, "manuals.playstation.net") || !strcmp(name, "ps5.host");
    bool answer = known && type == 1;
    memcpy(out, q, pos);
    out[2] = 0x84 | (q[2] & 1); // response, authoritative, copy RD
    out[3] = known ? 0 : 3;     // NXDOMAIN for other hosts; no upstream internet
    memset(out + 6, 0, 6);     // answer, authority, additional counts
    if (!answer) return pos;   // AAAA for a known name is NOERROR/no data
    out[7] = 1;
    const uint8_t record[] = {0xc0, 0x0c, 0, 1, 0, 1, 0, 0, 0, 60, 0, 4};
    memcpy(out + pos, record, sizeof(record));
    memcpy(out + pos + sizeof(record), ip, 4);
    return pos + 16;
}
